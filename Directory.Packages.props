<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The audio adapter's only dependency besides the core package. -->
    <PackageVersion Include="RecursiveAI.OneAudio" Version="1.7.0" />
    <!-- Test, bench and fuzz projects only. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
    <!-- Comparators: bench project only. TagLibSharp is LGPL and is only ever run as a black box there. -->
    <PackageVersion Include="SharpMP4" Version="0.3.2" />
    <PackageVersion Include="Matroska" Version="0.0.12" />
    <PackageVersion Include="MetadataExtractor" Version="2.9.3" />
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <PackageVersion Include="z440.atl.core" Version="7.19.0" />
    <PackageVersion Include="SubtitlesParser" Version="1.5.1" />
    <PackageVersion Include="libse" Version="5.3.0" />
  </ItemGroup>
</Project>
