    <RootNamespace>RecursiveAI.OneMedia.RemuxCheck</RootNamespace>
    <AssemblyName>OneMedia.RemuxCheck</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
