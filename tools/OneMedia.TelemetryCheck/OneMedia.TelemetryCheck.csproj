<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dumps decoded telemetry as text for tools/telemetry-compare.py and times the pull path. Never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.TelemetryCheck</RootNamespace>
    <AssemblyName>OneMedia.TelemetryCheck</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
