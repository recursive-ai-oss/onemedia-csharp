<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dumps the timed events of a file as plain text for tools/events-compare.py. Never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.EventsCheck</RootNamespace>
    <AssemblyName>OneMedia.EventsCheck</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
