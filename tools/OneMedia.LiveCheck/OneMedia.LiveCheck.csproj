<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads the playlists and MPD of a live presentation as a client would and checks every update; tools/package/live-paced.sh drives it. Never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.LiveCheck</RootNamespace>
    <AssemblyName>OneMedia.LiveCheck</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
