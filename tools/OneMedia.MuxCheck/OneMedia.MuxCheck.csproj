<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copies ISO files through the ISO muxer and reports; tools/run-mux-diff.sh compares the results with ffprobe. Never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.MuxCheck</RootNamespace>
    <AssemblyName>OneMedia.MuxCheck</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
