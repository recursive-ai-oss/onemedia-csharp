<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dumps subtitle tracks (raw packets, and cues once decoded) as text for the text-track differential. Never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.TextTrackCheck</RootNamespace>
    <AssemblyName>OneMedia.TextTrackCheck</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
