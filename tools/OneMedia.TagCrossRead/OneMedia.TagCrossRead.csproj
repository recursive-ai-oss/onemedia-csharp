<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads the files that the tag-write check wrote with two independent libraries (ATL.NET, TagLib#), as comparators only. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.TagCrossRead</RootNamespace>
    <AssemblyName>OneMedia.TagCrossRead</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" />
    <PackageReference Include="z440.atl.core" />
  </ItemGroup>

</Project>
