<Project Sdk="Microsoft.NET.Sdk">

  <!-- Applies a fixed tag edit set to real files and checks it: new values read back, other bytes copied, per-track payload hash unchanged,
       in-place saves within padding. Never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.TagWriteCheck</RootNamespace>
    <AssemblyName>OneMedia.TagWriteCheck</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
