<Project Sdk="Microsoft.NET.Sdk">

  <!-- Repairs files and compares the packets of a repaired file with those of the healthy original. Never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.RepairCheck</RootNamespace>
    <AssemblyName>OneMedia.RepairCheck</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
