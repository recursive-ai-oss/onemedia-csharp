<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sets the capture time of a real file with SaveAs and checks the result: what the resolver reads back, the per-track payload hash, and the report as JSON
       for the oracle comparison. Never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.DateWriteCheck</RootNamespace>
    <AssemblyName>OneMedia.DateWriteCheck</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
