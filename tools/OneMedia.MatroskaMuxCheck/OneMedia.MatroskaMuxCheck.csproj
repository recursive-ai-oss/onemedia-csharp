<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copy-muxes any file we can read into Matroska or WebM and checks the result against ffprobe (run as a black box). Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.MatroskaMuxCheck</RootNamespace>
    <AssemblyName>OneMedia.MatroskaMuxCheck</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
  </ItemGroup>

</Project>
