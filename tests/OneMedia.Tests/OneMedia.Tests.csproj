<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(PackagePrefix)OneMedia.Tests</AssemblyName>
    <RootNamespace>RecursiveAI.OneMedia.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
    <!-- Several tests assert zero allocations per packet or per parse. Tiered compilation allocates on the calling thread when it
         swaps in optimised code, which made those assertions flaky in parallel runs; the tests measure our code, not the JIT. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- A trivial demuxer shared with the smoke apps. -->
    <Compile Include="../../smoke/Shared/FixedPacketDemuxer.cs" Link="Shared/FixedPacketDemuxer.cs" />
    <!-- Writes synthetic MP4 files; shared with the comparison tool. -->
    <Compile Include="../../tools/OneMedia.IsoBmffDiff/Mp4Builder.cs" Link="Shared/Mp4Builder.cs" />
    <!-- Writes small ASF files; shared with the fuzz seeds. -->
    <Compile Include="../../tools/asf/AsfBuilder.cs" Link="Shared/AsfBuilder.cs" />
    <!-- Small fixtures and their ffprobe packet listings. -->
    <None Include="../../testdata/isobmff/*" Link="testdata/isobmff/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/isobmff/family/*" Link="testdata/isobmff/family/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/mpeg/*" Link="testdata/mpeg/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Tagged fixtures and the rendered mapping table. -->
    <None Include="../../testdata/metadata/*" Link="testdata/metadata/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/fuzz/tags/*" Link="testdata/fuzz/tags/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/fuzz/asf/*" Link="testdata/fuzz/asf/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/tag-mapping.md" Link="docs/tag-mapping.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The codec fuzz targets double as robustness checks: the tests feed them random, truncated and bit-flipped input. -->
    <Compile Include="../../fuzz/OneMedia.Fuzz/CodecFuzz.cs" Link="Codecs/CodecFuzz.cs" />
    <Compile Include="../../fuzz/OneMedia.Fuzz/AudioStreamFuzz.cs" Link="AudioStreams/AudioStreamFuzz.cs" />
    <None Include="../../testdata/fuzz/id3/*" Link="testdata/fuzz/id3/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/audio-es/*" Link="testdata/audio-es/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/audio-es/tagged/*" Link="testdata/audio-es/tagged/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/audio/*" Link="testdata/audio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/asf/*" Link="testdata/asf/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/heaac/*.m4a" Link="testdata/heaac/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
    <ProjectReference Include="../../src/OneMedia.Audio/OneMedia.Audio.csproj" />
  </ItemGroup>

</Project>
