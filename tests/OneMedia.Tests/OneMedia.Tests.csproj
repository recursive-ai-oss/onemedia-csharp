<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(PackagePrefix)OneMedia.Tests</AssemblyName>
    <RootNamespace>RecursiveAI.OneMedia.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
    <!-- Several tests assert zero allocations per packet or per parse. Tiered compilation allocates on the calling thread when it
         swaps in optimised code, which made those assertions flaky in parallel runs; the tests measure our code, not the JIT. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <Import Project="TestFiles.props" />

  <ItemGroup>
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
    <ProjectReference Include="../../src/OneMedia.Audio/OneMedia.Audio.csproj" />
    <ProjectReference Include="../../src/OneMedia.Tool/OneMedia.Tool.csproj" />
  </ItemGroup>

</Project>
