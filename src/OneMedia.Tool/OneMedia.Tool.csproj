<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>onemedia</AssemblyName>
    <RootNamespace>RecursiveAI.OneMedia.Tool</RootNamespace>
    <PackageId>$(PackagePrefix)OneMedia.Tool</PackageId>
    <Description>The onemedia command line tool: inspect media containers, edit tags, remux, trim, make files playable, strip location and device identifiers, repair damaged files and rebuild cut-off recordings, and convert and extract subtitles. Remux also writes MPEG-TS/M2TS and WAV/BWF/RF64. `package` writes CMAF or transport-stream segments with HLS playlists and a DASH MPD. Containers, metadata, subtitles; no decoding. Unaffiliated with other products or companies named OneMedia.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onemedia</ToolCommandName>
    <EnablePackageValidation>false</EnablePackageValidation>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(PackagePrefix)OneMedia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneMedia/OneMedia.csproj" />
    <ProjectReference Include="../OneMedia.Audio/OneMedia.Audio.csproj" />
  </ItemGroup>

</Project>
