<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>onemedia</AssemblyName>
    <RootNamespace>RecursiveAI.OneMedia.Tool</RootNamespace>
    <PackageId>$(PackagePrefix)OneMedia.Tool</PackageId>
    <Description>The onemedia command line tool: inspect media containers (and, as the library grows, edit tags, remux, trim, repair and package them). Containers, metadata, subtitles; no decoding. Unaffiliated with other products or companies named OneMedia.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onemedia</ToolCommandName>
    <EnablePackageValidation>false</EnablePackageValidation>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneMedia/OneMedia.csproj" />
    <ProjectReference Include="../OneMedia.Audio/OneMedia.Audio.csproj" />
  </ItemGroup>

</Project>
