    <ProjectReference Include="../../src/OneMedia.Audio/OneMedia.Audio.csproj" />
    <None Include="../../testdata/repair/tiny.mp4" Link="fixtures/tiny.mp4" CopyToOutputDirectory="PreserveNewest" />
