    <None Include="../../testdata/subtitles/sample.srt" Link="fixtures/sample.srt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/audio/aac.m4a" Link="fixtures/aac.m4a" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
