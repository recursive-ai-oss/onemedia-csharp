<Project Sdk="Microsoft.NET.Sdk">

  <!-- The same smoke run as the AOT app, hosted by the browser-wasm runtime (run with node or a headless browser). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneMedia.Smoke</RootNamespace>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../../tools/OneMedia.IsoBmffDiff/Mp4Builder.cs" Link="Shared/Mp4Builder.cs" />
    <WasmExtraFilesToDeploy Include="main.mjs" />
    <ProjectReference Include="../../src/OneMedia/OneMedia.csproj" />
    <ProjectReference Include="../../src/OneMedia.Audio/OneMedia.Audio.csproj" />
    <EmbeddedResource Include="../../testdata/audio/opus.webm" LogicalName="opus.webm" />
    <EmbeddedResource Include="../../testdata/telemetry/gpmf-synthetic.mp4" LogicalName="gpmf-synthetic.mp4" />
    <EmbeddedResource Include="../../testdata/telemetry/camm-all-types.mp4" LogicalName="camm-all-types.mp4" />
    <EmbeddedResource Include="../../testdata/telemetry/mebx-synthetic.mp4" LogicalName="mebx-synthetic.mp4" />
    <EmbeddedResource Include="../../testdata/telemetry/dji-text.mp4" LogicalName="dji-text.mp4" />
    <EmbeddedResource Include="../../testdata/telemetry/djmd-real.mp4" LogicalName="djmd-real.mp4" />
    <EmbeddedResource Include="../../testdata/telemetry/mdpm-gps.mts" LogicalName="mdpm-gps.mts" />
    <EmbeddedResource Include="../../testdata/telemetry/dji-formats.srt" LogicalName="dji-formats.srt" />
    <EmbeddedResource Include="../../testdata/audio/aac.m4a" LogicalName="aac.m4a" />
    <EmbeddedResource Include="../../testdata/asf/wmav2-tagged.wma" LogicalName="wmav2-tagged.wma" />
    <EmbeddedResource Include="../../testdata/mpeg/h264-aac.ts" LogicalName="h264-aac.ts" />
    <EmbeddedResource Include="../../testdata/mpeg/h264-aac.m2ts" LogicalName="h264-aac.m2ts" />
    <EmbeddedResource Include="../../testdata/mpeg/mpeg2-mp2.vob" LogicalName="mpeg2-mp2.vob" />
    <EmbeddedResource Include="../../testdata/mpeg/h264.264" LogicalName="h264.264" />
    <EmbeddedResource Include="../../testdata/mpeg/vp8.ivf" LogicalName="vp8.ivf" />
    <EmbeddedResource Include="../../testdata/audio-es/lame-info.mp3" LogicalName="lame-info.mp3" />
    <EmbeddedResource Include="../../testdata/audio-es/lc.aac" LogicalName="lc.aac" />
    <EmbeddedResource Include="../../testdata/audio-es/ac3.ac3" LogicalName="ac3.ac3" />
    <EmbeddedResource Include="../../testdata/audio-es/nb.amr" LogicalName="nb.amr" />
    <EmbeddedResource Include="../../testdata/audio-es/tagged/id3v24-basic.mp3" LogicalName="id3v24-basic.mp3" />
    <EmbeddedResource Include="../../testdata/audio/opus.ogg" LogicalName="opus.ogg" />
    <EmbeddedResource Include="../../testdata/audio/vorbis.ogg" LogicalName="vorbis.ogg" />
    <EmbeddedResource Include="../../testdata/xiph-flv/tags.flac" LogicalName="tags.flac" />
    <EmbeddedResource Include="../../testdata/xiph-flv/tiny.flv" LogicalName="tiny.flv" />
    <EmbeddedResource Include="../../testdata/avi/mjpeg-pcm.avi" LogicalName="mjpeg-pcm.avi" />
    <EmbeddedResource Include="../../testdata/avi/one-frame-pal-type1.avi" LogicalName="one-frame-pal-type1.avi" />
    <EmbeddedResource Include="../../testdata/avi/one-frame-pal.dv" LogicalName="one-frame-pal.dv" />
  </ItemGroup>

</Project>
